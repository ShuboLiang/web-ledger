generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ledger {
  id           String        @id @default(cuid())
  userId       String?       @unique @map("user_id")
  name         String
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  transactions Transaction[]
  projects     Project[]
  categories   Category[]
  accounts     Account[]
  accountTransfers AccountTransfer[]
  accountAdjustments AccountAdjustment[]
  liabilities Liability[]
  budgets      Budget[]
  tags         Tag[]
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ledgers")
}

model Transaction {
  id        Int      @id @default(autoincrement())
  ledgerId  String   @map("ledger_id")
  date      DateTime @db.Date
  amount    Decimal  @db.Decimal(14, 2)
  item      String   @db.VarChar(80)
  category1 String   @map("category1") @db.VarChar(40)
  category2 String   @map("category2") @db.VarChar(40)
  categoryId String  @map("category_id")
  accountId String?  @map("account_id")
  note      String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  liabilityPayments LiabilityPayment[]
  tags      TransactionTag[]

  @@index([ledgerId, date(sort: Desc), id(sort: Desc)])
  @@index([ledgerId, category1, category2])
  @@index([categoryId])
  @@map("transactions")
}

model Project {
  id        String   @id @default(cuid())
  ledgerId  String   @map("ledger_id")
  name      String   @db.VarChar(80)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@unique([ledgerId, name])
  @@map("projects")
}

model Category {
  id        String   @id @default(cuid())
  ledgerId  String   @map("ledger_id")
  category1 String   @db.VarChar(40)
  category2 String   @db.VarChar(40)
  primaryIcon String @default("folder") @map("primary_icon") @db.VarChar(40)
  secondaryIcon String @default("tag") @map("secondary_icon") @db.VarChar(40)
  enabled   Boolean  @default(true)
  mergedIntoId String? @map("merged_into_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  mergedInto Category? @relation("CategoryMerges", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom Category[] @relation("CategoryMerges")

  @@unique([ledgerId, category1, category2])
  @@index([mergedIntoId])
  @@map("categories")
}

model Account {
  id             String        @id @default(cuid())
  ledgerId       String        @map("ledger_id")
  name           String        @db.VarChar(80)
  type           String        @default("cash") @db.VarChar(30)
  openingBalance Decimal       @default(0) @map("opening_balance") @db.Decimal(14, 2)
  balanceDate    DateTime?      @map("balance_date") @db.Date
  isDefault      Boolean       @default(false) @map("is_default")
  enabled        Boolean       @default(true)
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  ledger         Ledger        @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  outgoingTransfers AccountTransfer[] @relation("TransferFrom")
  incomingTransfers AccountTransfer[] @relation("TransferTo")
  adjustments    AccountAdjustment[]
  liabilities    Liability[]
  liabilityPayments LiabilityPayment[] @relation("PaymentSource")

  @@unique([ledgerId, name])
  @@map("accounts")
}

model AccountAdjustment {
  id        String   @id @default(cuid())
  ledgerId  String   @map("ledger_id")
  accountId String   @map("account_id")
  date      DateTime @db.Date
  amount    Decimal  @db.Decimal(14, 2)
  note      String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([ledgerId, date(sort: Desc)])
  @@index([accountId])
  @@map("account_adjustments")
}

model AccountTransfer {
  id            String   @id @default(cuid())
  ledgerId      String   @map("ledger_id")
  date          DateTime @db.Date
  amount        Decimal  @db.Decimal(14, 2)
  fromAccountId String   @map("from_account_id")
  toAccountId   String   @map("to_account_id")
  kind          String   @default("transfer") @db.VarChar(30)
  note          String   @default("") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  ledger        Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  fromAccount   Account  @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     Account  @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  liabilityPayments LiabilityPayment[]

  @@index([ledgerId, date(sort: Desc)])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("account_transfers")
}

model Liability {
  id                String   @id @default(cuid())
  ledgerId          String   @map("ledger_id")
  accountId         String   @map("account_id")
  name              String   @db.VarChar(80)
  kind              String   @default("loan") @db.VarChar(30)
  originalPrincipal Decimal  @map("original_principal") @db.Decimal(14, 2)
  totalInterest     Decimal  @default(0) @map("total_interest") @db.Decimal(14, 2)
  startDate         DateTime @map("start_date") @db.Date
  firstDueDate      DateTime @map("first_due_date") @db.Date
  totalInstallments Int      @map("total_installments")
  status            String   @default("active") @db.VarChar(20)
  settledAt         DateTime? @map("settled_at") @db.Date
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  ledger            Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  installments      LiabilityInstallment[]
  payments          LiabilityPayment[]

  @@unique([ledgerId, accountId])
  @@index([ledgerId, status])
  @@map("liabilities")
}

model LiabilityInstallment {
  id          String   @id @default(cuid())
  liabilityId String   @map("liability_id")
  number      Int
  dueDate     DateTime @map("due_date") @db.Date
  principal   Decimal  @db.Decimal(14, 2)
  interest    Decimal  @default(0) @db.Decimal(14, 2)
  fee         Decimal  @default(0) @db.Decimal(14, 2)
  status      String   @default("planned") @db.VarChar(20)
  paymentId   String?  @map("payment_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  liability   Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
  payment     LiabilityPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([liabilityId, number])
  @@index([liabilityId, dueDate])
  @@map("liability_installments")
}

model LiabilityPayment {
  id                   String   @id @default(cuid())
  liabilityId          String   @map("liability_id")
  date                 DateTime @db.Date
  sourceAccountId      String   @map("source_account_id")
  principal            Decimal  @db.Decimal(14, 2)
  interest             Decimal  @default(0) @db.Decimal(14, 2)
  fee                  Decimal  @default(0) @db.Decimal(14, 2)
  kind                 String   @default("scheduled") @db.VarChar(30)
  note                 String   @default("") @db.VarChar(500)
  transferId           String   @unique @map("transfer_id")
  expenseTransactionId Int?     @map("expense_transaction_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  liability            Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
  sourceAccount        Account @relation("PaymentSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  transfer             AccountTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  expenseTransaction   Transaction? @relation(fields: [expenseTransactionId], references: [id], onDelete: SetNull)
  installments         LiabilityInstallment[]

  @@index([liabilityId, date(sort: Desc)])
  @@index([sourceAccountId])
  @@map("liability_payments")
}

model Budget {
  id        String   @id @default(cuid())
  ledgerId  String   @map("ledger_id")
  month     DateTime @db.Date
  category1 String?  @db.VarChar(40)
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@unique([ledgerId, month, category1])
  @@index([ledgerId, month])
  @@map("budgets")
}

model Tag {
  id        String   @id @default(cuid())
  ledgerId  String   @map("ledger_id")
  name      String   @db.VarChar(40)
  color     String   @default("#0f766e") @db.VarChar(20)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([ledgerId, name])
  @@map("tags")
}

model TransactionTag {
  transactionId Int      @map("transaction_id")
  tagId         String   @map("tag_id")
  createdAt     DateTime @default(now()) @map("created_at")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId, transactionId])
  @@map("transaction_tags")
}

model AiModelProfile {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  name       String   @db.VarChar(80)
  providerId String   @map("provider_id") @db.VarChar(100)
  modelId    String   @map("model_id") @db.VarChar(100)
  baseUrl    String   @map("base_url") @db.VarChar(500)
  apiType    String   @map("api_type") @db.VarChar(50)
  authHeader Boolean  @default(true) @map("auth_header")
  apiKey     String?  @map("api_key") @db.Text
  thinkingEnabled Boolean @default(false) @map("thinking_enabled")
  thinkingLevel   String  @default("medium") @map("thinking_level") @db.VarChar(20)
  isDefault  Boolean  @default(false) @map("is_default")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, isDefault])
  @@map("ai_model_profiles")
}

model AiConversation {
  id               String      @id @db.VarChar(80)
  userId           String?     @map("user_id")
  title            String      @default("新对话") @db.VarChar(80)
  pendingProposals Json        @default("[]") @map("pending_proposals")
  removedNotices   Json        @default("[]") @map("removed_notices")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  messages         AiMessage[]
  user             User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique @db.VarChar(40)
  displayName  String        @map("display_name") @db.VarChar(60)
  passwordHash String        @map("password_hash") @db.Text
  tokenVersion Int           @default(0) @map("token_version")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  ledger       Ledger?
  sessions     AuthSession[]
  aiProfiles   AiModelProfile[]
  conversations AiConversation[]

  @@map("users")
}

model AuthSession {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  tokenVersion Int       @map("token_version")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String         @map("conversation_id") @db.VarChar(80)
  role           String         @db.VarChar(20)
  content        String         @db.Text
  thinking       String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
