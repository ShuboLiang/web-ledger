generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ledger {
  id           String        @id @default(cuid())
  userId       String?       @unique @map("user_id")
  name         String
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  transactions Transaction[]
  projects     Project[]
  categories   Category[]
  accounts     Account[]
  accountTransfers AccountTransfer[]
  accountAdjustments AccountAdjustment[]
  budgets      Budget[]
  tags         Tag[]
  recurringRules RecurringRule[]
  lendingEntries LendingEntry[]
  lendingSettlements LendingSettlement[]
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ledgers")
}

model Transaction {
  id        Int      @id @default(autoincrement())
  ledgerId  String   @map("ledger_id")
  date      DateTime @db.Date
  amount    Decimal  @db.Decimal(14, 2)
  item      String   @db.VarChar(80)
  category1 String   @map("category1") @db.VarChar(40)
  category2 String   @map("category2") @db.VarChar(40)
  categoryId String  @map("category_id")
  accountId String?  @map("account_id")
  note      String   @default("") @db.VarChar(500)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  tags      TransactionTag[]
  recurringGenerations RecurringGeneration[]
  lendingEntries LendingEntry[]

  @@index([ledgerId, date(sort: Desc), id(sort: Desc)])
  @@index([ledgerId, category1, category2])
  @@index([ledgerId, deletedAt])
  @@index([categoryId])
  @@map("transactions")
}

model Project {
  id        String   @id @default(cuid())
  ledgerId  String   @map("ledger_id")
  name      String   @db.VarChar(80)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@unique([ledgerId, name])
  @@map("projects")
}

model Category {
  id        String   @id @default(cuid())
  ledgerId  String   @map("ledger_id")
  category1 String   @db.VarChar(40)
  category2 String   @db.VarChar(40)
  primaryIcon String @default("folder") @map("primary_icon") @db.VarChar(40)
  secondaryIcon String @default("tag") @map("secondary_icon") @db.VarChar(40)
  enabled   Boolean  @default(true)
  mergedIntoId String? @map("merged_into_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  mergedInto Category? @relation("CategoryMerges", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom Category[] @relation("CategoryMerges")

  @@unique([ledgerId, category1, category2])
  @@index([mergedIntoId])
  @@map("categories")
}

model Account {
  id             String        @id @default(cuid())
  ledgerId       String        @map("ledger_id")
  name           String        @db.VarChar(80)
  type           String        @default("cash") @db.VarChar(30)
  openingBalance Decimal       @default(0) @map("opening_balance") @db.Decimal(14, 2)
  balanceDate    DateTime?      @map("balance_date") @db.Date
  isDefault      Boolean       @default(false) @map("is_default")
  enabled        Boolean       @default(true)
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  ledger         Ledger        @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  outgoingTransfers AccountTransfer[] @relation("TransferFrom")
  incomingTransfers AccountTransfer[] @relation("TransferTo")
  adjustments    AccountAdjustment[]
  recurringRules RecurringRule[]
  lendingEntries LendingEntry[]

  @@unique([ledgerId, name])
  @@map("accounts")
}

model AccountAdjustment {
  id        String   @id @default(cuid())
  ledgerId  String   @map("ledger_id")
  accountId String   @map("account_id")
  date      DateTime @db.Date
  amount    Decimal  @db.Decimal(14, 2)
  note      String   @default("") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([ledgerId, date(sort: Desc)])
  @@index([accountId])
  @@map("account_adjustments")
}

model AccountTransfer {
  id            String   @id @default(cuid())
  ledgerId      String   @map("ledger_id")
  date          DateTime @db.Date
  amount        Decimal  @db.Decimal(14, 2)
  fromAccountId String   @map("from_account_id")
  toAccountId   String   @map("to_account_id")
  kind          String   @default("transfer") @db.VarChar(30)
  note          String   @default("") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  ledger        Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  fromAccount   Account  @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     Account  @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  lendingEntries LendingEntry[]
  lendingSettlements LendingSettlement[]

  @@index([ledgerId, date(sort: Desc)])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("account_transfers")
}

model LendingEntry {
  id            String   @id @default(cuid())
  ledgerId      String   @map("ledger_id")
  accountId     String   @map("account_id")
  direction     String   @db.VarChar(20)
  date          DateTime @db.Date
  amount        Decimal  @db.Decimal(14, 2)
  settledAmount Decimal  @default(0) @map("settled_amount") @db.Decimal(14, 2)
  item          String   @db.VarChar(80)
  note          String   @default("") @db.VarChar(500)
  dueDate       DateTime? @map("due_date") @db.Date
  status        String   @default("open") @db.VarChar(20)
  settledAt     DateTime? @map("settled_at")
  transferId    String?  @map("transfer_id")
  transactionId Int?     @map("transaction_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  ledger        Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transfer      AccountTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  settlements   LendingSettlement[]

  @@index([ledgerId, status, dueDate])
  @@index([ledgerId, accountId, date(sort: Desc)])
  @@index([transferId])
  @@index([transactionId])
  @@map("lending_entries")
}

model LendingSettlement {
  id         String   @id @default(cuid())
  ledgerId   String   @map("ledger_id")
  entryId    String   @map("entry_id")
  date       DateTime @db.Date
  amount     Decimal  @db.Decimal(14, 2)
  note       String   @default("") @db.VarChar(500)
  transferId String?  @map("transfer_id")
  createdAt  DateTime @default(now()) @map("created_at")
  ledger     Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  entry      LendingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  transfer   AccountTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@index([ledgerId, date(sort: Desc)])
  @@index([entryId])
  @@index([transferId])
  @@map("lending_settlements")
}

model Budget {
  id        String   @id @default(cuid())
  ledgerId  String   @map("ledger_id")
  month     DateTime @db.Date
  category1 String?  @db.VarChar(40)
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@unique([ledgerId, month, category1])
  @@index([ledgerId, month])
  @@map("budgets")
}

model RecurringRule {
  id              String   @id @default(cuid())
  ledgerId        String   @map("ledger_id")
  frequency       String   @db.VarChar(20)
  interval        Int      @default(1)
  dayOfMonth      Int?     @map("day_of_month")
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  nextRunDate     DateTime @map("next_run_date") @db.Date
  amount          Decimal  @db.Decimal(14, 2)
  direction       String   @default("expense") @db.VarChar(10)
  item            String   @db.VarChar(80)
  category1       String   @db.VarChar(40)
  category2       String   @db.VarChar(40)
  accountId       String?  @map("account_id")
  note            String   @default("") @db.VarChar(500)
  autoCreate      Boolean  @default(true) @map("auto_create")
  enabled         Boolean  @default(true)
  lastGeneratedAt DateTime? @map("last_generated_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  ledger          Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  account         Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  generations     RecurringGeneration[]

  @@index([ledgerId, enabled, nextRunDate])
  @@index([enabled, nextRunDate])
  @@map("recurring_rules")
}

model RecurringGeneration {
  id            String   @id @default(cuid())
  ruleId        String   @map("rule_id")
  runDate       DateTime @map("run_date") @db.Date
  status        String   @db.VarChar(20)
  transactionId Int?     @map("transaction_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  rule          RecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  transaction   Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([ruleId, runDate])
  @@index([ruleId, status])
  @@index([transactionId])
  @@map("recurring_generations")
}

model Tag {
  id        String   @id @default(cuid())
  ledgerId  String   @map("ledger_id")
  name      String   @db.VarChar(40)
  color     String   @default("#0f766e") @db.VarChar(20)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([ledgerId, name])
  @@map("tags")
}

model TransactionTag {
  transactionId Int      @map("transaction_id")
  tagId         String   @map("tag_id")
  createdAt     DateTime @default(now()) @map("created_at")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId, transactionId])
  @@map("transaction_tags")
}

model AiModelProfile {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  name       String   @db.VarChar(80)
  providerId String   @map("provider_id") @db.VarChar(100)
  modelId    String   @map("model_id") @db.VarChar(100)
  baseUrl    String   @map("base_url") @db.VarChar(500)
  apiType    String   @map("api_type") @db.VarChar(50)
  authHeader Boolean  @default(true) @map("auth_header")
  apiKey     String?  @map("api_key") @db.Text
  thinkingEnabled Boolean @default(false) @map("thinking_enabled")
  thinkingLevel   String  @default("medium") @map("thinking_level") @db.VarChar(20)
  isDefault  Boolean  @default(false) @map("is_default")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, isDefault])
  @@map("ai_model_profiles")
}

model AiConversation {
  id               String      @id @db.VarChar(80)
  userId           String?     @map("user_id")
  title            String      @default("新对话") @db.VarChar(80)
  pendingProposals Json        @default("[]") @map("pending_proposals")
  removedNotices   Json        @default("[]") @map("removed_notices")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  messages         AiMessage[]
  user             User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique @db.VarChar(40)
  displayName  String        @map("display_name") @db.VarChar(60)
  passwordHash String        @map("password_hash") @db.Text
  tokenVersion Int           @default(0) @map("token_version")
  aiCustomPrompt String      @default("") @map("ai_custom_prompt") @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  ledger       Ledger?
  sessions     AuthSession[]
  aiProfiles   AiModelProfile[]
  conversations AiConversation[]

  @@map("users")
}

model AuthSession {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  tokenVersion Int       @map("token_version")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String         @map("conversation_id") @db.VarChar(80)
  role           String         @db.VarChar(20)
  content        String         @db.Text
  thinking       String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
