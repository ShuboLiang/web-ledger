PORT=3218
POSTGRES_PORT=5432
POSTGRES_DB=qing_zhang
POSTGRES_USER=qing_zhang_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://qing_zhang_app:replace-with-a-long-random-password@127.0.0.1:5432/qing_zhang?schema=public
DATABASE_URL_DOCKER=postgresql://qing_zhang_app:replace-with-a-long-random-password@postgres:5432/qing_zhang?schema=public
QING_ZHANG_DATA_DIR=./data
QING_ZHANG_BACKUP_DIR=./backups
# HTTPS 反向代理部署时设为 1；直接通过 HTTP 访问保持 0。
COOKIE_SECURE=0

# 模型、Base URL 和 API Key 请在网页的“AI 设置”中配置。

# 旧 SQLite 兼容模式可选：自定义数据库文件位置。
# DB_PATH=./data/ledger.sqlite
