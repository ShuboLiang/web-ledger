{
  "name": "qing-zhang-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "带自然语言 AI 录入的本地网页记账应用",
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "vite build --configLoader runner",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:import-sqlite": "node scripts/migrate-sqlite-to-postgres.mjs",
    "start": "node dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "dev": "concurrently -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/main.ts",
    "dev:web": "vite --configLoader runner",
    "test": "npm run build && node tests/smoke.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p apps/web/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/plots": "^2.6.8",
    "@ant-design/x": "^2.9.0",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/serve-static": "^5.0.5",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.101.4",
    "antd": "^6.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dayjs": "^1.11.21",
    "helmet": "^8.3.0",
    "prisma": "^6.19.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "typebox": "^1.3.12",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.2.0"
  }
}
